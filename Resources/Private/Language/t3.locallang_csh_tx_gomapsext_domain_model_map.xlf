<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:go_maps_ext/Resources/Private/Language/locallang_csh_tx_gomapsext_domain_model_map.xlf" date="2023-03-17T16:05:18Z" product-name="go_maps_ext" target-language="t3">
    <header/>
    <body>
      <trans-unit id="addresses.description" resname="addresses.description">
        <source>You can choose, create or edit an address. New addresses will be saved on the current page.</source>
        <target>crwdns313338:0crwdne313338:0</target>
      </trans-unit>
      <trans-unit id="calc_route.description" resname="calc_route.description">
        <source>Only 1 address used as destination. Display an text input for enter a starting point.</source>
        <target>crwdns313340:0crwdne313340:0</target>
      </trans-unit>
      <trans-unit id="class.description" resname="class.description">
        <source>The class of the map container</source>
        <target>crwdns313342:0crwdne313342:0</target>
      </trans-unit>
      <trans-unit id="default_type.description" resname="default_type.description">
        <source>Maptype on the beginning.</source>
        <target>crwdns313344:0crwdne313344:0</target>
      </trans-unit>
      <trans-unit id="double_click_zoom.description" resname="double_click_zoom.description">
        <source>A double click on the map zooms in. Draggable map has to be enabled!</source>
        <target>crwdns313346:0crwdne313346:0</target>
      </trans-unit>
      <trans-unit id="draggable.description" resname="draggable.description">
        <source>Position of the map can be changed.</source>
        <target>crwdns313348:0crwdne313348:0</target>
      </trans-unit>
      <trans-unit id="fullscreen_control.description" resname="fullscreen_control.description">
        <source>Shows an icon to enable the fullscreen.</source>
        <target>crwdns313350:0crwdne313350:0</target>
      </trans-unit>
      <trans-unit id="height.description" resname="height.description">
        <source>Set the height of the map. Default in px, for percentages enter %, e.g. '100%'.</source>
        <target>crwdns313352:0crwdne313352:0</target>
      </trans-unit>
      <trans-unit id="kml_local.description" resname="kml_local.description">
        <source>The KML file is stored on this server. The specified path is relative. Only markers appear.</source>
        <target>crwdns313354:0crwdne313354:0</target>
      </trans-unit>
      <trans-unit id="kml_preserve_viewport.description" resname="kml_preserve_viewport.description">
        <source>The viewport of the kml file will be ignored. Set zoom and at least one address to configure the viewport.</source>
        <target>crwdns313356:0crwdne313356:0</target>
      </trans-unit>
      <trans-unit id="kml_url.description" resname="kml_url.description">
        <source>Enter an URL of a KML file, e.g. &quot;https://developers.google.com/maps/documentation/javascript/examples/kml/westcampus.kml&quot;.</source>
        <target>crwdns342094:0crwdne342094:0</target>
      </trans-unit>
      <trans-unit id="latitude.description" resname="latitude.description">
        <source>If set this latitude will be used to center the map. Otherwise the center is calculated so that all addresses fit in the map.</source>
        <target>crwdns313360:0crwdne313360:0</target>
      </trans-unit>
      <trans-unit id="longitude.description" resname="longitude.description">
        <source>If set this longitude will be used to center the map. Otherwise the center is calculated so that all addresses fit in the map.</source>
        <target>crwdns313362:0crwdne313362:0</target>
      </trans-unit>
      <trans-unit id="geolocation.description" resname="geolocation.description">
        <source>If set geolocation is activated. If location is possible and allowed by the user, a marker is shown representing the actual position and the map is centered to this point.</source>
        <target>crwdns313364:0crwdne313364:0</target>
      </trans-unit>
      <trans-unit id="map_type_control.description" resname="map_type_control.description">
        <source>Shows a control to change the map type.</source>
        <target>crwdns313366:0crwdne313366:0</target>
      </trans-unit>
      <trans-unit id="map_types.description" resname="map_types.description">
        <source>Possible map types to choose. Map type control has to be enabled.</source>
        <target>crwdns313368:0crwdne313368:0</target>
      </trans-unit>
      <trans-unit id="marker_cluster.description" resname="marker_cluster.description">
        <source>Many markers in the same region will be summarized and appear as a cluster.</source>
        <target>crwdns313370:0crwdne313370:0</target>
      </trans-unit>
      <trans-unit id="marker_cluster_size.description" resname="marker_cluster_size.description">
        <source>The size of the Clusters, like a radius.</source>
        <target>crwdns313372:0crwdne313372:0</target>
      </trans-unit>
      <trans-unit id="marker_cluster_style.description" resname="marker_cluster_style.description">
        <source>JSON Code, for more information visit  https://github.com/googlemaps/js-markerclusterer</source>
        <target>crwdns342096:0crwdne342096:0</target>
      </trans-unit>
      <trans-unit id="marker_cluster_zoom.description" resname="marker_cluster_zoom.description">
        <source>Up to this zoom level the Clusters are displayed.</source>
        <target>crwdns313376:0crwdne313376:0</target>
      </trans-unit>
      <trans-unit id="marker_search.description" resname="marker_search.description">
        <source>Displays a form on the frontend, were the user can enter a search word. Searchs for InfoWindow content and title of a marker. The InfoWindow of the first found marker opens.</source>
        <target>crwdns313378:0crwdne313378:0</target>
      </trans-unit>
      <trans-unit id="preview_image.description" resname="preview_image.description">
        <source>Define an image to show as preview of the current map. If previews are enabled, this image will be shown instead of the map. Only when the user clicks on the image, data from Google will be loaded and the map will be displayed.</source>
        <target>crwdns313380:0crwdne313380:0</target>
      </trans-unit>
      <trans-unit id="scale_control.description" resname="scale_control.description">
        <source>Displays a measure.</source>
        <target>crwdns313382:0crwdne313382:0</target>
      </trans-unit>
      <trans-unit id="scroll_zoom.description" resname="scroll_zoom.description">
        <source>Enables zoom with scroll wheel. </source>
        <target>crwdns313384:0crwdne313384:0</target>
      </trans-unit>
      <trans-unit id="show_addresses.description" resname="show_addresses.description">
        <source>Displays a list with all addresses incl. a link. If you click the selected address will be centered.</source>
        <target>crwdns313386:0crwdne313386:0</target>
      </trans-unit>
      <trans-unit id="show_categories.description" resname="show_categories.description">
        <source>Displays for each category a checkbox. Only the selected categories will be shown.</source>
        <target>crwdns313388:0crwdne313388:0</target>
      </trans-unit>
      <trans-unit id="show_route.description" resname="show_route.description">
        <source>2 address records needed! Shows the route between the given points.</source>
        <target>crwdns313390:0crwdne313390:0</target>
      </trans-unit>
      <trans-unit id="streetview_control.description" resname="streetview_control.description">
        <source>Shows an icon to enable the streetview.</source>
        <target>crwdns313392:0crwdne313392:0</target>
      </trans-unit>
      <trans-unit id="styled_map_code.description" resname="styled_map_code.description">
        <source>JSON Code, for more information visit https://mapstyle.withgoogle.com/</source>
        <target>crwdns313394:0crwdne313394:0</target>
      </trans-unit>
      <trans-unit id="styled_map_name.description" resname="styled_map_name.description">
        <source>Shown in the map type control.</source>
        <target>crwdns313396:0crwdne313396:0</target>
      </trans-unit>
      <trans-unit id="title.description" resname="title.description">
        <source>Will be used as ID (without space character, special character!).</source>
        <target>crwdns313398:0crwdne313398:0</target>
      </trans-unit>
      <trans-unit id="tooltip_title.description" resname="tooltip_title.description">
        <source>Shown by mouse over.</source>
        <target>crwdns313400:0crwdne313400:0</target>
      </trans-unit>
      <trans-unit id="travel_mode.description" resname="travel_mode.description">
        <source>Select a travel mode or let the frontend user select one.</source>
        <target>crwdns313402:0crwdne313402:0</target>
      </trans-unit>
      <trans-unit id="unit_system.description" resname="unit_system.description">
        <source>Select a unit system or let the frontend user select one.</source>
        <target>crwdns313404:0crwdne313404:0</target>
      </trans-unit>
      <trans-unit id="width.description" resname="width.description">
        <source>Set the width of the map. Default in px, for percentages enter %, e.g. '100%'.</source>
        <target>crwdns313406:0crwdne313406:0</target>
      </trans-unit>
      <trans-unit id="zoom.description" resname="zoom.description">
        <source>Only need to set if default zoom is wrong.</source>
        <target>crwdns313408:0crwdne313408:0</target>
      </trans-unit>
      <trans-unit id="zoom_control.description" resname="zoom_control.description">
        <source>Enable buttons to change the zoom.</source>
        <target>crwdns313410:0crwdne313410:0</target>
      </trans-unit>
      <trans-unit id="zoom_max.description" resname="zoom_max.description">
        <source>The maximum zoom level which will be displayed on the map. If omitted, or set to null, the maximum zoom from the current map type is used instead.</source>
        <target>crwdns313412:0crwdne313412:0</target>
      </trans-unit>
      <trans-unit id="zoom_min.description" resname="zoom_min.description">
        <source>The minimum zoom level which will be displayed on the map. If omitted, or set to null, the minimum zoom from the current map type is used instead.</source>
        <target>crwdns313414:0crwdne313414:0</target>
      </trans-unit>
    </body>
  </file>
</xliff>
